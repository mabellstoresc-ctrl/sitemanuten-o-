# Copie para .env apenas para rodar localmente. NUNCA suba o .env para o GitHub.
# Na Netlify, configure estas variáveis em: Site configuration > Environment variables.

# String de conexão do Postgres (Supabase > Connect > "Transaction pooler", porta 6543)
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Supabase Storage (fotos, PDFs e comprovantes)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=chave-secreta-service-role

# Senha inicial do Administrador Principal (usuário "bernardo").
# Usada só na primeira inicialização; no primeiro login o sistema pede para trocar.
ADMIN_INITIAL_PASSWORD=

# Opcional: se o administrador esquecer a senha, preencha esta variável,
# faça um novo deploy e entre com ela (o sistema pedirá uma senha nova).
# Depois apague a variável.
ADMIN_RESET_PASSWORD=
